{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "server.js",
  "description": "API Server for the application",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "generate:openapi": "tsx src/openapi/generate.ts",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@repo/contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/db-schema": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "lint-staged": "^17.3.0",
    "openapi3-ts": "^4.6.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
