{
  "name": "native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "ios:15": "expo run:ios --device 'iPhone 15'",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-navigation/native": "^7.3.17",
    "@repo/api-client": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/ui-native": "workspace:*",
    "@repo/ui-theme": "workspace:*",
    "@rn-primitives/portal": "~1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.102.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-native": "0.87.0",
    "react-native-css-interop": "^0.2.6",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.12.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/react": "~19.2.18",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.8.3"
  },
  "private": true,
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
