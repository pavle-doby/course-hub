{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@repo/contract": ["../contract/src/index.ts"],
      "@repo/contract/*": ["../contract/src/*"],
      "@repo/shared/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
