{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@repo/db-schema": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.7.2",
    "drizzle-kit": "^0.31.5",
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
