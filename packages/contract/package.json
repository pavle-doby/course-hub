{
  "name": "@repo/contract",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "lint-staged": "^17.0.7"
  },
  "dependencies": {
    "@repo/db-schema": "workspace:*",
    "drizzle-zod": "^0.7.0",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
