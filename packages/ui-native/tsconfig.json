{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "paths": {
      "@repo/ui-native/*": ["./src/*"]
    }
  },
  "include": ["src", "nativewind-env.d.ts"],
  "exclude": ["node_modules"]
}
