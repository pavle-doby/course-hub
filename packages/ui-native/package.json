{
  "name": "@repo/ui-native",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@repo/ui-theme": "workspace:*",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner-native": "^0.27.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@rn-primitives/slot": ">=1.4.0",
    "lucide-react-native": ">=0.400.0",
    "nativewind": ">=4.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rn-primitives/slot": "^1.5.2",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "lint-staged": "^17.3.0",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "typescript": "5.8.3"
  },
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
