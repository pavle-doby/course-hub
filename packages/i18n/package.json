{
  "name": "@repo/i18n",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "react-native": "src/native.ts",
  "exports": {
    ".": {
      "react-native": "./src/native.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "default": "./src/server.ts"
    },
    "./constants": {
      "default": "./src/constants.ts"
    },
    "./resources": {
      "default": "./src/resources.ts"
    },
    "./client": {
      "default": "./src/client.ts"
    },
    "./native": {
      "default": "./src/native.ts"
    }
  },
  "dependencies": {
    "i18next": "^26.4.0",
    "next-i18next": "^16.0.11",
    "react-i18next": "^17.0.12"
  },
  "peerDependencies": {
    "expo-localization": "*"
  },
  "peerDependenciesMeta": {
    "expo-localization": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "expo-localization": "^57.0.2",
    "lint-staged": "^17.3.0"
  },
  "scripts": {
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
