{
  "name": "@repo/db-schema",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "lint-staged": "^17.0.7"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
